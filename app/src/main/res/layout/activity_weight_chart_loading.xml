<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF8">

    <!-- Thanh điều hướng dưới đáy (Active: Cân nặng) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#F2F6F3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Trang chủ"
                android:src="@drawable/ic_homee"
                app:tint="#6B7280" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navWeight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_active"
                android:backgroundTint="#DCECE3">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Cân nặng"
                    android:src="@drawable/ic_weightt"
                    app:tint="#1B6B45" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navRecommendations"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Gợi ý"
                android:src="@drawable/ic_goiyy"
                app:tint="#6B7280" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Hồ sơ"
                android:src="@drawable/ic_user"
                app:tint="#6B7280" />
        </FrameLayout>
    </LinearLayout>

    <!-- Nội dung chính -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:clipToPadding="false"
        android:padding="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header: Tiêu đề Cân nặng + Icon Lịch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Cân nặng"
                    android:textColor="#111827"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCalendar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Chọn ngày"
                    android:src="@drawable/ic_calendar"
                    app:tint="#111827" />
            </RelativeLayout>

            <!-- Thanh chuyển tab Lịch sử | Biểu đồ (Active: Biểu đồ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_active"
                android:backgroundTint="#EEF2EF"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tvTabHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Lịch sử"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTabChart"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_active"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center"
                    android:text="Biểu đồ"
                    android:textColor="#1B6B45"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bộ lọc mốc thời gian: 1 tháng | 3 tháng | 6 tháng -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTimeRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip1Month"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="1 tháng"
                    android:textColor="#1B6B45"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="#E3F1E8"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip3Months"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 tháng"
                    android:textColor="#6B7280"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeColor="#E5E7EB"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip6Months"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 tháng"
                    android:textColor="#6B7280"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeColor="#E5E7EB"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Thẻ Skeleton biểu đồ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#EDF2EE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- 3 thanh chỉ số tiêu đề -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="130dp"
                        android:layout_height="12dp"
                        app:cardBackgroundColor="#DFE5E1"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="175dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#DFE5E1"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="155dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#DFE5E1"
                        app:cardCornerRadius="5dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp" />

                    <!-- Khung vùng biểu đồ với 4 đường kẻ ngang -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="185dp"
                        android:layout_marginTop="18dp"
                        app:cardBackgroundColor="#EEF2EF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingVertical="14dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#DFE5E1" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#DFE5E1" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#DFE5E1" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#DFE5E1" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 3 nhãn trục hoành (Trái - Giữa - Phải) -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="46dp"
                            android:layout_height="10dp"
                            android:layout_alignParentStart="true"
                            app:cardBackgroundColor="#DFE5E1"
                            app:cardCornerRadius="5dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="46dp"
                            android:layout_height="10dp"
                            android:layout_centerHorizontal="true"
                            app:cardBackgroundColor="#DFE5E1"
                            app:cardCornerRadius="5dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="46dp"
                            android:layout_height="10dp"
                            android:layout_alignParentEnd="true"
                            app:cardBackgroundColor="#DFE5E1"
                            app:cardCornerRadius="5dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trạng thái vòng xoay đang tải -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressChartLoading"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="#1B6B45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Đang chuẩn bị biểu đồ..."
                    android:textColor="#4B5563"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Các số đo đang được tổng hợp. Vui lòng chờ trong giây lát."
                android:textColor="#6B7280"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>