<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF8">

    <!-- Thanh điều hướng dưới đáy (Active: Cân nặng) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#F2F6F3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Trang chủ"
                android:src="@drawable/ic_homee"
                app:tint="#6B7280" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navWeight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_active"
                android:backgroundTint="#DCECE3">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Cân nặng"
                    android:src="@drawable/ic_weightt"
                    app:tint="#1B6B45" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navRecommendations"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Gợi ý"
                android:src="@drawable/ic_goiyy"
                app:tint="#6B7280" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Hồ sơ"
                android:src="@drawable/ic_user"
                app:tint="#6B7280" />
        </FrameLayout>
    </LinearLayout>

    <!-- Nội dung chính -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:clipToPadding="false"
        android:padding="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header: Tiêu đề Cân nặng + Icon Lịch -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Cân nặng"
                    android:textColor="#111827"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCalendar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Chọn ngày"
                    android:src="@drawable/ic_calendar"
                    app:tint="#111827" />
            </RelativeLayout>

            <!-- Thanh chuyển tab Lịch sử | Biểu đồ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_active"
                android:backgroundTint="#EEF2EF"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tvTabHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_active"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center"
                    android:text="Lịch sử"
                    android:textColor="#1B6B45"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTabChart"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Biểu đồ"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Khung Skeleton 1: Thẻ cân nặng gần nhất -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#EDF2EE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="145dp"
                        android:layout_height="12dp"
                        app:cardBackgroundColor="#DFE5E1"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="210dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#DFE5E1"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thanh Skeleton bộ đếm số bản ghi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="160dp"
                android:layout_height="14dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#DFE5E1"
                app:cardCornerRadius="7dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <!-- Khung Skeleton 2: Danh sách 5 bản ghi đang tải -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#EDF2EE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Dòng skeleton 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="105dp"
                                android:layout_height="12dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="140dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="5dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="54dp"
                            android:layout_height="24dp"
                            app:cardBackgroundColor="#DFE5E1"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" />
                    </LinearLayout>

                    <!-- Dòng skeleton 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="105dp"
                                android:layout_height="12dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="140dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="5dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="54dp"
                            android:layout_height="24dp"
                            app:cardBackgroundColor="#DFE5E1"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" />
                    </LinearLayout>

                    <!-- Dòng skeleton 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="105dp"
                                android:layout_height="12dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="140dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="5dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="54dp"
                            android:layout_height="24dp"
                            app:cardBackgroundColor="#DFE5E1"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" />
                    </LinearLayout>

                    <!-- Dòng skeleton 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="105dp"
                                android:layout_height="12dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="140dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="5dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="54dp"
                            android:layout_height="24dp"
                            app:cardBackgroundColor="#DFE5E1"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" />
                    </LinearLayout>

                    <!-- Dòng skeleton 5 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="105dp"
                                android:layout_height="12dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="140dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#DFE5E1"
                                app:cardCornerRadius="5dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="54dp"
                            android:layout_height="24dp"
                            app:cardBackgroundColor="#DFE5E1"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trạng thái vòng xoay đang tải -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressLoading"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="#1B6B45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Đang tải lịch sử cân nặng..."
                    android:textColor="#4B5563"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Dữ liệu của bạn sẽ xuất hiện trong giây lát."
                android:textColor="#6B7280"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>