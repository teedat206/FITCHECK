<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF7"
    tools:context=".ui.WeightHistoryActivity">

    <!-- Header: Tiêu đề & Icon lịch -->
    <TextView
        android:id="@+id/tvTitleWeight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/title_weight"
        android:textColor="#1F2937"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivCalendar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/ic_calendar"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitleWeight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitleWeight" />

    <!-- Thanh chuyển Tab (Lịch sử / Biểu đồ) -->
    <LinearLayout
        android:id="@+id/llTabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="#E5E7EB"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleWeight">

        <TextView
            android:id="@+id/tvTabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:gravity="center"
            android:text="@string/tab_history"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTabChart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_chart"
            android:textColor="#6B7280" />
    </LinearLayout>

    <!-- Card Tổng quan cân nặng gần nhất -->
    <!-- Card Tổng quan cân nặng gần nhất (Đã fix chuẩn không bị tràn chữ) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLatest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#E6F0EC"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@+id/llTabs">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvLabelLatest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_latest_weight"
                android:textColor="#047857"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Số cân nặng (56,0 kg) -->
            <TextView
                android:id="@+id/tvLatestWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="56,0"
                android:textColor="#111827"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLabelLatest" />

            <TextView
                android:id="@+id/tvUnitKg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="kg"
                android:textColor="#4B5563"
                android:textSize="16sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvLatestWeight"
                app:layout_constraintStart_toEndOf="@+id/tvLatestWeight" />

            <!-- Chênh lệch (ghim sát mép phải, có không gian rộng rãi) -->
            <TextView
                android:id="@+id/tvWeightDiff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ 1,2 kg trong 4 tuần"
                android:textColor="#047857"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tvLatestWeight"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvLatestWeight" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tiêu đề danh sách & số bản ghi -->
    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="@string/section_date_range"
        android:textColor="#1F2937"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardLatest" />

    <TextView
        android:id="@+id/tvRecordCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="@string/record_count"
        android:textColor="#6B7280"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvSectionTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSectionTitle" />

    <!-- Nhóm hiển thị Data -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="cardLatest,tvSectionTitle,tvRecordCount,rvWeightList,btnAddWeight" />

    <!-- RecyclerView chứa danh sách lịch sử -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWeightList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/btnAddWeight"
        app:layout_constraintTop_toBottomOf="@+id/tvSectionTitle"
        tools:listitem="@layout/item_weight_record" />

    <!-- Nút "+ Thêm cân nặng" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddWeight"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/primary_green"
        android:text="@string/btn_add_weight"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation" />

    <!-- Nhóm hiển thị Empty -->
    <include
        android:id="@+id/layoutEmpty"
        layout="@layout/layout_weight_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/llTabs"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation" />

    <!-- ProgressBar Loading -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/llTabs"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Thanh điều hướng Bottom Navigation với tên icon mới -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#EBF3EE"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Tab 1: Trang chủ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_homee" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Trang chủ"
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 2: Cân nặng (Đang chọn - có nền bo tròn mint) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_active"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_weightt" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cân nặng"
                android:textColor="@color/primary_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 3: Gợi ý -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_goiyy" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Gợi ý"
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Hồ sơ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_user" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hồ sơ"
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>